# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Auth Configuration (Enable Email, Facebook, and Phone providers in Supabase Dashboard)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Public shareable invite base URL
VITE_PUBLIC_INVITE_URL="https://riadchat.vercel.app"

# Optional external API/WebSocket backend origin (leave empty for same-origin Express server)
VITE_API_BASE_URL=""

# Server-Side Security & Secrets (NEVER expose these with VITE_ prefix)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Optional AES-256-GCM encryption passphrase for encrypting the local JSON database at rest
DB_ENCRYPTION_KEY=""

# Primary Owner (ID: 900) admin email and password (leave password empty to use one-time first-run claim)
PRIMARY_ADMIN_EMAIL="rrrrrrrrrr2030r@gmail.com"
PRIMARY_ADMIN_PASSWORD=""

# Comma-separated list of additional trusted CORS origins (e.g. https://yourdomain.com)
CORS_ALLOWED_ORIGINS=""

# Agency 2FA OTP Delivery — SMS via Twilio (leave empty for dev-only preview mode)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Agency 2FA OTP Delivery — Email via Resend OR SMTP (leave empty for dev-only preview mode)
RESEND_API_KEY=""
OTP_EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional HTTPS Webhooks for Off-Server Encrypted Backups and 1-Minute Outage Alerts
BACKUP_WEBHOOK_URL=""
ALERT_WEBHOOK_URL=""

# Optional CDN Base URL for static images/assets (leave empty to serve from same origin with long-term caching)
VITE_CDN_BASE_URL=""
