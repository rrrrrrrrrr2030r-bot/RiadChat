{
  "name": "riyadh-chat-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "رياض شات (Riyadh Chat) — Native React Native iOS & Android App with Voice Rooms, Lucky Games & Deep-Link Invites",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start --reset-cache",
    "link:native": "bash ./scripts/link-native.sh",
    "pod:install": "cd ios && bundle exec pod install",
    "doctor": "npx react-native doctor",
    "typecheck": "tsc --noEmit",
    "verify:autolink": "npx react-native config"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.0",
    "@react-navigation/bottom-tabs": "7.2.0",
    "@react-navigation/native": "7.0.14",
    "@react-navigation/native-stack": "7.2.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.66.0",
    "expo-local-authentication": "~15.0.2",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-gesture-handler": "2.20.2",
    "react-native-haptic-feedback": "2.3.3",
    "react-native-linear-gradient": "2.8.3",
    "react-native-reanimated": "3.16.6",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-share": "12.0.3",
    "react-native-svg": "15.8.0",
    "react-native-vector-icons": "10.2.0",
    "react-native-webrtc": "124.0.4"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@react-native/babel-preset": "0.76.6",
    "@react-native/metro-config": "0.76.6",
    "@react-native/typescript-config": "0.76.6",
    "@types/react": "18.3.12",
    "@types/react-native-vector-icons": "6.4.18",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
