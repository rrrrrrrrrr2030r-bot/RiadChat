{
  "name": "RiyadhChat",
  "displayName": "رياض شات",
  "icon": "./assets/app-icon.png",
  "scheme": "riyadhchat",
  "android": {
    "package": "com.riyadhchat.app",
    "permissions": [
      "android.permission.INTERNET",
      "android.permission.RECORD_AUDIO",
      "android.permission.MODIFY_AUDIO_SETTINGS",
      "android.permission.VIBRATE",
      "android.permission.WAKE_LOCK",
      "android.permission.USE_BIOMETRIC",
      "android.permission.USE_FINGERPRINT"
    ],
    "intentFilters": [
      {
        "action": "VIEW",
        "autoVerify": true,
        "data": [
          {
            "scheme": "riyadhchat",
            "host": "invite"
          },
          {
            "scheme": "riyadhchat",
            "host": "room"
          },
          {
            "scheme": "https",
            "host": "ais-pre-a7c3aeq5qwiwm34deodtyr-421264512085.europe-west2.run.app",
            "pathPrefix": "/"
          }
        ],
        "category": ["BROWSABLE", "DEFAULT"]
      }
    ]
  },
  "ios": {
    "bundleIdentifier": "com.riyadhchat.app",
    "infoPlist": {
      "NSMicrophoneUsageDescription": "يحتاج تطبيق رياض شات إلى إذن الميكروفون للتحدث داخل الغرف الصوتية المباشرة.",
      "NSFaceIDUsageDescription": "يحتاج تطبيق رياض شات إلى إذن التعرف على الوجه لتسجيل الدخول السريع والآمن إلى جلستك المحفوظة.",
      "UIBackgroundModes": ["audio"],
      "CFBundleURLTypes": [
        {
          "CFBundleURLSchemes": ["riyadhchat"]
        }
      ]
    }
  }
}
